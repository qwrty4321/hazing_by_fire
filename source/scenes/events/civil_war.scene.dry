title: Civil War
audio: music/communist/A_las_barricadas.ogg
on-arrival: {!
Q.rb_strength = Math.round(Q.rb_strength);
Q.sh_strength = Math.round(Q.sh_strength);
Q.sa_strength = Math.round(Q.sa_strength);
Q.rfb_strength = Math.round(Q.rfb_strength);
// re-calculate dissent, in case we transitioned from, say, the KPD support that raised reformist dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;
var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;

Q.dissent = 0.01*total_dissent/total_strength;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

Q.civil_war_seen = 1;

Q.revolutionary_power = 0;

Q.revolutionary_rb = Q.rb_strength * Q.rb_militancy * Q.rb_revolutionaries / Q.rb_total;
if (Q.civil_war_type == 1) {
    Q.revolutionary_power += Q.revolutionary_rb;
} else if (Q.civil_war_type != 1) {
    Q.revolutionary_power += Q.revolutionary_rb // 2;
}

Q.revolutionary_rfb = Q.rfb_strength * Q.rfb_militancy;
Q.revolutionary_power += Q.revolutionary_rfb;

Q.revolutionary_prussian_police = Q.prussian_police_strength * Q.prussian_police_militancy * Q.prussian_police_revolutionaries / Q.prussian_police_total;
if (Q.civil_war_type == 1 && Q.spd_in_government) {
    Q.revolutionary_power += Q.revolutionary_prussian_police;
} else {
    Q.revolutionary_power += Q.revoltuionary_prussian_police // 2;
}

Q.revolutionary_reichswehr = Q.reichswehr_strength * Q.reichswehr_militancy * Q.reichswehr_revolutionaries / Q.reichswehr_total;
if (Q.civil_war_type == 1 && Q.spd_in_government) {
    Q.revolutionary_power += Q.revolutionary_reichswehr;
} else {
    Q.revolutionary_power += Q.revoltuionary_reichswehr // 2;
}

Q.republican_power = 0;

Q.republican_rb = Q.rb_strength * Q.rb_militancy * Q.rb_republicans / Q.rb_total;
if (Q.civil_war_type == 1) {
    Q.republican_power += Q.republican_rb // 2;
} else if (Q.civil_war_type != 1) {
    Q.republican_power += Q.republican_rb;
}

Q.republican_prussian_police = Q.prussian_police_strength * Q.prussian_police_militancy * Q.prussian_police_republicans / Q.prussian_police_total;
if (Q.civil_war_type == 1 && Q.spd_in_government) {
    Q.republican_power += Q.republican_prussian_police // 2;
} else {
    Q.republican_power += Q.republican_prussian_police;
}

Q.republican_reichswehr = Q.reichswehr_strength * Q.reichswehr_militancy * Q.reichswehr_republicans / Q.reichswehr_total;
if (Q.civil_war_type == 1 && Q.spd_in_government) {
    Q.republican_power += Q.republican_reichswehr // 2;
} else {
    Q.republican_power += Q.republican_reichswehr;
}

Q.reactionary_power = 0

Q.reactionary_sh = Q.sh_strength * Q.sh_militancy;
Q.reactionary_power += Q.reactionary_sh;

Q.reactionary_sa = Q.sa_strength * Q.sa_militancy;
Q.reactionary_power += Q.reactionary_sa;

Q.reactionary_prussian_police = Q.prussian_police_strength * Q.prussian_police_militancy * Q.prussian_police_reactionaries / Q.prussian_police_total;
if (Q.civil_war_type == 0 && Q.spd_in_government) {
    Q.reactionary_power += Q.reactionary_prussian_police // 2;
} else {
    Q.reactionary_power += Q.reactionary_prussian_police;
}

Q.reactionary_reichswehr = Q.reichswehr_strength * Q.reichswehr_militancy * Q.reichswehr_reactionaries / Q.reichswehr_total;
if (Q.civil_war_type == 0 && Q.spd_in_government) {
    Q.reactionary_power += Q.reactionary_reichswehr // 2;
} else {
    Q.reactionary_power += Q.reactionary_reichswehr;
}

if (Q.civil_war_type == 0) {
    if (Q.revolutionary_power + Q.republican_power > Q.reactionary_power * 1.2) {
        Q.victory = 2
    } else if (Q.revolutionary_power + Q.republican_power > Q.reactionary_power) {
        Q.victory = 1
    } else {
        Q.victory = 0
    }
} else if (Q.civil_war_type == 1) {
    if (Q.revolutionary_power * 0.8 > Q.reactionary_power + Q.republican_power) {
        Q.victory = 2
    } else if (Q.revolutionary_power > Q.reactionary_power + Q.republican_power) {
        Q.victory = 1
    } else {
        Q.victory = 0
    }
} else if (Q.civil_war_type == 2) {
    if (Q.revolutionary_power > Q.reactionary_power + Q.republican_power) {
        Q.victory = 0
    } else if (Q.revolutionary_power * 1.2 > Q.reactionary_power + Q.republican_power) {
        Q.victory = 1
    } else {
        Q.victory = 2
    }
}
!}
go-to: coup_menu if civil_war_type = 0; united_revolution_menu if civil_war_type = 1; kpd_revolution_menu if civil_war_type = 2

= The Array of Forces

Our enemies are [? if civil_war_type = 0 : the <span style="color: #808080;">nationalist</span> <span style="color: #3E88B3;">**Stahlhelm**</span>, with [+ sh_strength +] thousand troops, and the <span style="color: #7A3C00;">Nazi</span> <span style="color: #7A3C00;">**SA**</span>, with [+ sa_strength +] thousand troops. ?] [? if civil_war_type = 1 : the reactionary, bourgeois <span style="color: #3E88B3;">**Stahlhelm**</span>, with [+ sh_strength +] thousand troops, and the <span style="color: #7A3C00;">Nazi</span> <span style="color: #7A3C00;">**SA**</span>, with [+ sa_strength +] thousand troops. ?] [? if civil_war_type = 2 : the radical, revolutionary RFB, with [+ rfb_strength +] thousand troops ?] The loyalties of the [? if civil_war_type = 1 : republican Reichsbanner, with its [+ rb_strength +] members, the ?] Reichswehr, with its [+ reichswehr_strength +] thousand regular soldiers, and Prussian police, with [+ prussian_police_strength +] thousand members, are unclear.

On our side, we have [? if civil_war_type = 0: the Reichsbanner, at [+ rb_strength +] thousand members. [? if total_dissent > 0.3 : The Reichsbanner is weakened by dissent within the party, as many members choose not to fight. ?] ?] [? if civil_war_type = 1 : the loyal portions of the Reichsbanner, which has [+ rb_strength +] thousand members, and the RFB, which has [+ rfb_strength +] members. ?] [? if civil_war_type = 2 : the loyal parts of the Reichsbanner, with [+ rb_strength +] members, and the reactionary SA with [+ sa_strength +] thousand and Stahlhelm with [+ sh_strength +] thousand members. ?]

[? if rb_militancy < 0.25 : Unfortunately, the Reichsbanner are poorly trained and equipped, and will not be able to stand against our more militarized opponents. ?][? if rb_militancy >= 0.25 and rb_militancy < 0.5 : We have spent some resources training and equipping the Reichsbanner. Let us hope our people can persist. ?][? if rb_militancy >= 0.5 : We have spent quite a great deal of resources on turning the Reichsbanner into a fighting force. Let us hope that they survive. ?]

What else do we have?

# note: many scenarios lead to civil war. This calculates the array of forces, and the possible outcomes.

